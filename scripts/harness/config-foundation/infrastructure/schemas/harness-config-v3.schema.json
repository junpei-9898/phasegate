{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "layers",
    "quickMode",
    "phaseDependencies",
    "planningMode",
    "harnesses",
    "paths",
    "reporting"
  ],
  "$defs": {
    "effectCapability": {
      "type": "string",
      "enum": ["filesystem", "network", "database", "process-env", "time", "random", "subprocess", "user-io"]
    },
    "decisionSignal": {
      "type": "string",
      "enum": ["business-rule-branch", "validation-rule", "error-construction", "state-transition", "policy-selection"]
    }
  },
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "preset"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "strict"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "docs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "construction": {
                  "type": "string",
                  "minLength": 1
                },
                "inception": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "L1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "L2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validators": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "L3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validators": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "coverageThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "requirementMatrixPath": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "L4": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validators": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "quickMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedCategories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "maintainedLayers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "relaxedGates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "fullModeRequiredWhen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mixedCategories": {
              "type": "boolean"
            },
            "newDomainFile": {
              "type": "boolean"
            },
            "apiContractChange": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "phaseDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "default",
            "full",
            "standard",
            "minimal",
            "custom"
          ]
        },
        "override": {
          "type": "boolean"
        },
        "customRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "requires"
            ],
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "level",
              "requires",
              "blocks",
              "dependsOn"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "level": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "required"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              },
              "storyAnnotation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "required",
                  "tag"
                ],
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "storyAnnotation"
                  ]
                },
                "then": {
                  "properties": {
                    "level": {
                      "const": 3
                    }
                  }
                }
              }
            ]
          }
        },
        "storyReflection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inception",
                  "product",
                  "required"
                ],
                "properties": {
                  "inception": {
                    "type": "string",
                    "minLength": 1
                  },
                  "product": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "preCommit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementationExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "planningMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "perPhase"
      ],
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "interactive",
            "embedded-qa",
            "manual"
          ]
        },
        "perPhase": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "interactive",
              "embedded-qa",
              "manual"
            ]
          }
        }
      }
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentLessonCollection": {
          "type": "boolean"
        },
        "cascadeUpdate": {
          "type": "boolean"
        },
        "bundleSizeLimit": {
          "type": "number",
          "minimum": 0
        },
        "deadCodeGC": {
          "type": "boolean"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designDocs",
        "inceptionDocs"
      ],
      "properties": {
        "designDocs": {
          "type": "string",
          "minLength": 1
        },
        "inceptionDocs": {
          "type": "string",
          "minLength": 1
        },
        "principlesDocs": {
          "type": "string",
          "minLength": 1
        },
        "folderRulesDoc": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "outputDir"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "outputDir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failOnWarning": {
          "type": "boolean"
        }
      }
    },
    "modelRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation"
      ],
      "properties": {
        "delegation": {
          "type": "string",
          "enum": [
            "delegate-sonnet",
            "none"
          ]
        }
      }
    },
    "protectedFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "agentIntegration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stopHook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enforce": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset"],
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["clean", "strict-ddd", "onion", "hexagonal", "layered", "flat", "custom"]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "allowedDependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "uniqueItems": true
          }
        },
        "metadataTags": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "layer": {
              "type": "string",
              "pattern": "^@[a-z][a-zA-Z0-9]*$"
            },
            "unit": {
              "type": "string",
              "pattern": "^@[a-z][a-zA-Z0-9]*$"
            }
          }
        },
        "layerDetection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "byPath": { "type": "boolean" },
            "byTag": { "type": "boolean" }
          }
        },
        "capabilityPolicies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed", "denied"],
            "properties": {
              "allowed": {
                "type": "array",
                "items": { "$ref": "#/$defs/effectCapability" },
                "uniqueItems": true
              },
              "denied": {
                "type": "array",
                "items": { "$ref": "#/$defs/effectCapability" },
                "uniqueItems": true
              }
            }
          }
        },
        "decisionPolicies": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expected", "advisoryOnly"],
            "properties": {
              "expected": {
                "type": "array",
                "items": { "$ref": "#/$defs/decisionSignal" },
                "uniqueItems": true
              },
              "advisoryOnly": { "type": "boolean" }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "preset": { "const": "custom" } }, "required": ["preset"] },
          "then": { "required": ["preset", "layers", "allowedDependencies"] }
        }
      ]
    },
    "phase2Extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialCreationExpirationRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "documentPattern",
              "daysThreshold",
              "commitCountThreshold",
              "evaluationMode"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "documentPattern": {
                "type": "string",
                "minLength": 1
              },
              "daysThreshold": {
                "type": "number",
                "minimum": 0
              },
              "commitCountThreshold": {
                "type": "number",
                "minimum": 0
              },
              "evaluationMode": {
                "type": "string",
                "enum": [
                  "or",
                  "and"
                ]
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "uniqueItems": true
        }
      }
    }
  }
}
