{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "layers",
    "quickMode",
    "phaseDependencies",
    "planningMode",
    "harnesses",
    "paths",
    "reporting"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "preset"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "preset": {
          "type": "string",
          "enum": [
            "minimal",
            "standard",
            "strict"
          ]
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "docs": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "construction": {
                  "type": "string",
                  "minLength": 1
                },
                "inception": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "layers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "L1": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "L2": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validators": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "L3": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validators": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "coverageThreshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "requirementMatrixPath": {
              "type": "string",
              "minLength": 1
            },
            "acBoundStories": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "L4": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "validators": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "schedule": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "quickMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowedCategories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "maintainedLayers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "relaxedGates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "fullModeRequiredWhen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mixedCategories": {
              "type": "boolean"
            },
            "newDomainFile": {
              "type": "boolean"
            },
            "apiContractChange": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "phaseDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset"
      ],
      "properties": {
        "preset": {
          "type": "string",
          "enum": [
            "default",
            "full",
            "standard",
            "minimal",
            "custom"
          ]
        },
        "override": {
          "type": "boolean"
        },
        "customRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "phase",
              "requires"
            ],
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "level",
              "requires",
              "blocks",
              "dependsOn"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "level": {
                "type": "integer",
                "enum": [
                  1,
                  2,
                  3
                ]
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "required"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "required": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "blocks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependsOn": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                }
              },
              "storyAnnotation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "required",
                  "tag"
                ],
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "storyAnnotation"
                  ]
                },
                "then": {
                  "properties": {
                    "level": {
                      "const": 3
                    }
                  }
                }
              }
            ]
          }
        },
        "storyReflection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "mappings": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "inception",
                  "product",
                  "required"
                ],
                "properties": {
                  "inception": {
                    "type": "string",
                    "minLength": 1
                  },
                  "product": {
                    "type": "string",
                    "minLength": 1
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "preCommit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implementationExtensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.[A-Za-z0-9]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "planningMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "perPhase"
      ],
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "interactive",
            "embedded-qa",
            "manual"
          ]
        },
        "perPhase": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "interactive",
              "embedded-qa",
              "manual"
            ]
          }
        }
      }
    },
    "harnesses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentLessonCollection": {
          "type": "boolean"
        },
        "cascadeUpdate": {
          "type": "boolean"
        },
        "bundleSizeLimit": {
          "type": "number",
          "minimum": 0
        },
        "deadCodeGC": {
          "type": "boolean"
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designDocs",
        "inceptionDocs"
      ],
      "properties": {
        "designDocs": {
          "type": "string",
          "minLength": 1
        },
        "inceptionDocs": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "outputDir"
      ],
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "outputDir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "corpus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "productRoots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" }
            },
            "inceptionRoots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" }
            },
            "adrRoots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" }
            },
            "sourceRoots": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" }
            },
            "include": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "exclude": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matrixPath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" },
            "attestationPath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" },
            "integrityManifestPath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" }
          }
        },
        "declarations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "constraintsPath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" },
            "baselinePath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" },
            "waiversPath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" },
            "debtsPath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "obligationReportPath": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!\\.\\.?(?:/|$))(?!.*\\/\\.\\.?(?:/|$)).+$" }
          }
        },
        "sessionStart": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxItems": { "type": "integer", "minimum": 1, "maximum": 20 },
            "maxChars": { "type": "integer", "minimum": 1, "maximum": 8000 }
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failOnWarning": {
          "type": "boolean"
        }
      }
    },
    "modelRouting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation"
      ],
      "properties": {
        "delegation": {
          "type": "string",
          "enum": [
            "delegate-sonnet",
            "none"
          ]
        }
      }
    },
    "protectedFiles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "phase2Extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialCreationExpirationRules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ruleId",
              "documentPattern",
              "daysThreshold",
              "commitCountThreshold",
              "evaluationMode"
            ],
            "properties": {
              "ruleId": {
                "type": "string",
                "minLength": 1
              },
              "documentPattern": {
                "type": "string",
                "minLength": 1
              },
              "daysThreshold": {
                "type": "number",
                "minimum": 0
              },
              "commitCountThreshold": {
                "type": "number",
                "minimum": 0
              },
              "evaluationMode": {
                "type": "string",
                "enum": [
                  "or",
                  "and"
                ]
              },
              "enabled": {
                "type": "boolean"
              }
            }
          },
          "uniqueItems": true
        }
      }
    }
  }
}
