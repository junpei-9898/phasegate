{
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "stories"],
  "properties": {
    "version": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["storyId", "storyMappings"],
        "properties": {
          "storyId": {
            "type": "string",
            "pattern": "^H(?:F\\d+|\\d{2})-\\d{2}$"
          },
          "coverageStatus": {
            "type": "string",
            "enum": ["planned", "required"],
            "description": "WI-292 (schema 1.2): Story coverage gate lifecycle の現在値。省略時は required として扱う（1.0/1.1 後方互換）。"
          },
          "coverageLifecycle": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "string",
              "enum": ["planned", "required"]
            },
            "description": "WI-292 (schema 1.2): Git 管理された順方向遷移履歴。有効系列と status 終端一致は L3-004 が fail-closed で検査する。"
          },
          "storyMappings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["acId", "testReferences"],
              "properties": {
                "acId": {
                  "type": "string",
                  "pattern": "^AC-[1-9][0-9]*$"
                },
                "testReferences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["filePath", "testType"],
                    "properties": {
                      "filePath": {
                        "type": "string",
                        "minLength": 1
                      },
                      "testType": {
                        "type": "string",
                        "enum": ["unit", "it", "scenario"]
                      },
                      "testName": {
                        "type": "string"
                      },
                      "binding": {
                        "type": "string",
                        "enum": ["ac", "file"],
                        "description": "HF2-05 (schema 1.1): AC単位で紐づいた参照は 'ac'、@ac注釈なしで全ACにファンアウトした参照は 'file'。省略可（1.0後方互換）。"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
